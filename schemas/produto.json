{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Produto",
  "type": "object",
  "required": ["nome", "preco", "descricao", "quantidade", "_id"],
  "properties": {
    "nome": { "type": "string" },
    "preco": { "type": "integer", "minimum": 1 },
    "descricao": { "type": "string" },
    "quantidade": { "type": "integer", "minimum": 0 },
    "_id": { "type": "string" }
  }
}
